# For a GitHub project site, use /dentist/. Keep / for a custom domain.
VITE_BASE_PATH=/
# The real public origin, without the base path. Required for canonical and sitemap.
VITE_SITE_URL=
# Public Formspree form endpoint (not a secret). Configure allowed domains and spam protection in Formspree.
VITE_FORMSPREE_ENDPOINT=
# Optional Google Search Console HTML verification token.
VITE_GOOGLE_SITE_VERIFICATION=
